# Frontend environment (copy to .env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Public origin for canonical URLs, sitemap.xml and OG tags. Server-only and
# read at request time — deliberately not NEXT_PUBLIC_, which would bake it in.
SITE_URL=http://localhost:3000
