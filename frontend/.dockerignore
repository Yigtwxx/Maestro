# package-lock.json is NOT ignored: npm ci requires it.
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# All .env* files: next build would otherwise inline the builder host's
# NEXT_PUBLIC_* values, defeating the domain-agnostic single-build image.
.env*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

.git/
.gitignore
Dockerfile
.dockerignore
