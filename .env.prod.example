# =========================================================================
# Maestro Platform — production environment.
# Copy to `.env.prod`, fill every value, keep it off git and off backups that
# leave the host. Compose reads it twice: for ${...} interpolation
# (`--env-file .env.prod`) and as the backend container's environment.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =========================================================================

# --- App ---
ENVIRONMENT=production
LOG_LEVEL=INFO
# Structured JSON logs (one object per line) for aggregation in production.
LOG_FORMAT=json

# --- Observability (Sentry error tracking) ---
# Paste the DSN from your Sentry project. Empty = disabled (no error tracking).
SENTRY_DSN=
# Tracing/APM sample rate (0.0 = off, protects the free-tier quota and host RAM).
SENTRY_TRACES_SAMPLE_RATE=0.0
# Sentry environment tag; falls back to ENVIRONMENT when empty.
SENTRY_ENVIRONMENT=production
# Frontend Sentry DSN — a *separate* Sentry project (platform: Next.js) from
# the backend's SENTRY_DSN above. Empty = frontend error tracking disabled
# (no SDK chunk is served to browsers, zero egress).
FRONTEND_SENTRY_DSN=

# --- Health probes ---
# /health/ready stays public (an uptime monitor needs its 200/503), but *which*
# dependency is down is not: naming it hands an anonymous caller a live map of
# your infrastructure. Set this and send it as `X-Health-Token` to get the
# per-service breakdown. Empty withholds it from everyone. Grants nothing else.
#   openssl rand -hex 16
HEALTH_DETAIL_TOKEN=

# --- Operator alerting ---
# Without this a default deploy has NO alerting: nothing tells you the site is
# down or erroring. The backend watches its own dependencies and 5xx rate and
# pages you on a state change. Both channels empty = silent no-op, zero egress.
# Configuring a channel *is* the enable — there is no separate switch.
#
# Slack or Discord incoming webhook (one payload serves both); anything that
# accepts a JSON POST works, including an internal notifier on this host. The
# URL is a bearer credential — it is never logged and never echoed in an error.
ALERT_WEBHOOK_URL=
# Operator address for the same alerts, delivered via EMAIL_PROVIDER below.
ALERT_EMAIL_TO=
# Tuning. Defaults shown; uncomment only to change them.
# ALERT_WATCHDOG_INTERVAL_SECONDS=60
# ALERT_READINESS_FAILURES=2
# ALERT_COOLDOWN_SECONDS=900
# ALERT_ERROR_RATE_THRESHOLD=0.05
# ALERT_ERROR_RATE_WINDOW_SECONDS=300
# ALERT_ERROR_RATE_MIN_REQUESTS=20

# --- Metrics (/metrics, Prometheus text format) ---
# Empty makes GET /metrics answer 404, so an unconfigured install does not
# advertise the surface. Set it and send it as `X-Metrics-Token` to scrape.
# A different token from HEALTH_DETAIL_TOKEN on purpose: this one is pasted
# into a long-lived scraper config and exposes traffic volume, latency and
# error rate. The Caddyfile does not route /metrics — reach it over an SSH
# tunnel or from inside the compose network.
#   openssl rand -hex 16
METRICS_TOKEN=

# Bare hostname → Caddy provisions TLS via ACME. Needs a DNS A record pointing
# here and ports 80/443 reachable. Use `http://localhost` for a local smoke test.
DOMAIN=maestro.example.com

# Public origin, scheme included, for canonical URLs, sitemap.xml and OG tags.
# Usually https://<DOMAIN>, but kept separate because DOMAIN may carry a scheme.
SITE_URL=https://maestro.example.com

# Image tag to run. The deploy workflow overrides this with the release version.
IMAGE_TAG=latest

# --- Secrets ---
# JWT_SECRET:         openssl rand -hex 32
# API_KEY_MASTER_KEY: openssl rand -base64 32   (AES-256-GCM, BYOK key encryption)
# Passwords:          openssl rand -base64 24
JWT_SECRET=
API_KEY_MASTER_KEY=
POSTGRES_PASSWORD=
MONGO_USER=maestro
MONGO_PASSWORD=
QDRANT_API_KEY=
REDIS_PASSWORD=

# --- Datastores (compose network hostnames) ---
# The backend refuses to boot with CHANGE_ME still in any of the three URLs below,
# or with a guessable password, so a forgotten substitution fails loudly at
# startup instead of running against an unauthenticated datastore. It does not
# demand a password where there is none: a datastore reachable only on the compose
# network may legitimately run without auth.
# Postgres is on 5432 here. The 5433 in the dev compose is only a host-side port
# mapping, worked around because Windows often already owns 5432.
# Substitute the passwords you generated above into these two URLs.
POSTGRES_URL=postgresql+asyncpg://maestro:CHANGE_ME@postgres:5432/maestro
# authSource=admin is required: without it the root user cannot authenticate and
# index creation fails at startup.
MONGODB_URL=mongodb://maestro:CHANGE_ME@mongo:27017/?authSource=admin
MONGODB_DB_NAME=maestro
QDRANT_URL=http://qdrant:6333

# --- Rate limiting ---
# Substitute REDIS_PASSWORD from above. Buckets are shared across backend
# workers and instances; if Redis goes down the limiter degrades to per-process
# buckets rather than taking the API with it.
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
# Must stay true: production refuses to boot with throttling off.
RATE_LIMIT_ENABLED=true
# Required behind Caddy. Without it every caller is bucketed under Caddy's
# container IP, so one client tripping the login limit locks out everyone.
# Required, not optional — production refuses to boot with it unset, because both
# mistakes are real: forged per-request buckets if it is on with the backend
# exposed directly, one shared bucket for every user if it is off behind Caddy.
TRUST_PROXY_HEADERS=true

# --- CORS ---
# The browser never makes a cross-origin request here, since Caddy serves the
# app and the API from one origin. Set anyway: the global exception handler
# writes CORS headers itself and checks this list.
CORS_ORIGINS=https://maestro.example.com

# --- Embeddings ---
# RAG and document upload need these whatever chat provider the user picked.
# Served by the compose `ollama` service, which pulls only this small model.
EMBEDDING_ENDPOINT=http://ollama:11434/v1
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIM=768

# --- Free chat tier (off on hosted deployments) ---
# The compose `ollama` service serves embeddings only; no chat model is pulled.
# With OLLAMA_CHAT_ENABLED=false, picking the free model returns an explicit
# 400 at task start instead of a task whose every subtask fails. Embeddings
# (above) are unaffected. To actually offer the free tier: pull a chat model
# (docker compose -f docker-compose.prod.yml exec ollama ollama pull qwen3.5:9b),
# raise the ollama service memory limit well above 2g (a 9B model does not fit),
# then set this to true. See docs/DEPLOYMENT.md "Models".
OLLAMA_CHAT_ENABLED=false
FREE_MODEL_ENDPOINT=http://ollama:11434/v1
FREE_MODEL_NAME=qwen3.5:9b

# --- Gemini (BYOK; the key itself is added per-user in Settings) ---
# "-latest" alias survives model retirements; pin a stable id if needed.
GEMINI_MODEL_NAME=gemini-flash-latest

# --- Analytics (optional, self-hosted Umami) ---
# Leave everything here empty to run without analytics — the default. Nothing
# loads in the browser and the storage notice stays informational. To enable:
#   1. COMPOSE_PROFILES=analytics
#   2. UMAMI_DB_PASSWORD: openssl rand -base64 24
#      UMAMI_APP_SECRET:  openssl rand -hex 32
#   3. `up -d`, SSH-tunnel to the dashboard, change the default password,
#      create the website, paste its id into UMAMI_WEBSITE_ID, `up -d frontend`.
#      Full steps: docs/DEPLOYMENT.md "Analytics".
#
# Comma-separated, so `analytics,uptime` enables both. The "uptime" profile
# adds a ~5MB curl sidecar that probes the backend from outside the process and
# POSTs to ALERT_WEBHOOK_URL itself — it is the only thing that can report a
# backend which is wedged or OOM-killed, since the in-process watchdog is then
# not running. It requires ALERT_WEBHOOK_URL to be set. It cannot report this
# *host* being down; keep a free external monitor on https://<DOMAIN>/health.
COMPOSE_PROFILES=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_WEBSITE_ID=
# Uptime sidecar tuning (defaults shown).
# UPTIME_INTERVAL_SECONDS=60
# UPTIME_FAILURES_BEFORE_ALERT=2

# --- Transactional email ---
# A hosted instance needs a real sender: verification, password reset and
# deletion-lifecycle emails. "console" only logs the messages (self-host/dev).
# The backend refuses to boot with EMAIL_PROVIDER=resend and an empty key.
# EMAIL_FROM must be a sender your Resend domain is verified for.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Maestro <noreply@maestro.example.com>
# Unverified accounts get 403 on task start, API-key create and custom-API-tool
# writes until they confirm their address. Off while onboarding friction is not
# wanted — a deliberate product choice here, not a technical limit: this file
# already configures a real sender above, so the gate would work if turned on.
# Flip it together with EMAIL_VERIFICATION_LIVE in
# frontend/src/lib/legal/config.ts, which the backend cannot read.
EMAIL_VERIFICATION_REQUIRED=false

# --- Signup abuse protection ---
# none | turnstile. "none" is not "unprotected": the honeypot and the signed
# form-challenge layers still run, and no third party is contacted. There is no
# production guard forcing a provider -- requiring one would refuse to boot
# every self-hosted deployment. What production *does* refuse is
# CAPTCHA_PROVIDER=turnstile with either key left empty, because a provider
# that cannot verify fails closed on every call and stops registration
# silently.
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Payments ---
# Only the mock provider exists. Never enter a real card against it.
PAYMENT_PROVIDER=mock

# --- Code execution ---
# Off. Turning it on requires mounting /var/run/docker.sock into the backend,
# which hands any code the agent runs full control of this host.
CODE_EXECUTION_ENABLED=false

# --- Web search (DuckDuckGo via ddgs; no API key) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_USES_PER_SUBTASK=2

# --- Agent limits ---
MAX_ITERATIONS=10
MAX_REVIEW_ITERATIONS=3
TASK_TIMEOUT_SECONDS=1800

# --- Retention (Mongo TTL on task_sessions and agent_logs) ---
# Keep >= the 14-day trend window or the oldest sparkline days read as zero.
TASK_RETENTION_DAYS=30

# --- Auth token lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Refresh cookie ---
# The defaults are the secure ones and need no entry here: Secure is on outside
# development (the boot guard refuses production without it), SameSite is strict,
# and the cookie is host-only. Uncomment DOMAIN only for an app./api. split under
# one registrable domain — it shares the session cookie with every subdomain.
# A frontend on a *different* domain should proxy /api through BACKEND_ORIGIN
# instead; SameSite=none is not offered, because it would remove the only CSRF
# control on /auth/refresh and /auth/logout.
# REFRESH_COOKIE_DOMAIN=.example.com

# --- LLM HTTP client timeouts (seconds) ---
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_CONNECT_TIMEOUT_SECONDS=10

# --- Custom LLM endpoint SSRF guard ---
# Keep true on a hosted deployment: it blocks a user-supplied custom base_url
# from reaching cloud metadata (169.254.169.254) or internal services
# (qdrant:6333, redis:6379, ...) via a server-side request.
LLM_SSRF_GUARD_ENABLED=true
