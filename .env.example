# =========================================================================
# Maestro Platform — Environment Variables (example)
# Copy to `.env` and fill real values. NEVER commit `.env`.
# =========================================================================

# --- Databases ---
POSTGRES_URL=postgresql+asyncpg://maestro:maestro@localhost:5433/maestro
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=maestro

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Rate limiting ---
# Leave REDIS_URL empty to keep buckets in process memory (correct for a single
# dev worker). Set it to share them across workers: `docker compose up -d redis`.
REDIS_URL=
# RATE_LIMIT_ENABLED=false turns throttling off entirely. Never in production.
RATE_LIMIT_ENABLED=true
# Only true behind a reverse proxy that appends X-Forwarded-For. With the
# backend directly exposed, a client could forge the header and dodge its bucket.
TRUST_PROXY_HEADERS=false

# --- Security ---
# Generate JWT secret:        openssl rand -hex 32
JWT_SECRET=change-me-please-generate-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# AES-256-GCM master key (32 bytes, base64 or 64-char hex).
# Generate:                   openssl rand -base64 32
API_KEY_MASTER_KEY=change-me-32-byte-base64-master-key

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Payments ---
# Only "mock" is implemented: it validates Visa/Mastercard numbers (Luhn, BIN)
# and moves no real money. Plugging in a real processor means adding an adapter
# under app/services/payment/, not changing this value's consumers.
# Prices, quotas and the trial length are product constants, not env config.
PAYMENT_PROVIDER=mock

# --- Free / local model (Ollama, OpenAI-compatible) ---
FREE_MODEL_ENDPOINT=http://localhost:11434/v1
FREE_MODEL_NAME=qwen3.5:9b
# RAG and document upload need embeddings whatever chat provider is selected.
# Leave blank to reuse FREE_MODEL_ENDPOINT (the usual local setup). A deployment
# can point this at an embedding-only server without hosting a chat model.
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL_NAME=nomic-embed-text
# nomic-embed-text embedding dimension
EMBEDDING_DIM=768

# --- Gemini (BYOK free tier; key is added per-user via Settings > API Keys) ---
# Model served through Gemini's OpenAI-compatible endpoint.
# If this model is not on the free tier, use gemini-2.5-flash instead.
GEMINI_MODEL_NAME=gemini-3.5-flash

# --- Web search (DuckDuckGo via ddgs — free, no API key) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_USES_PER_SUBTASK=2

# --- Default agent limits ---
MAX_ITERATIONS=10
MAX_REVIEW_ITERATIONS=3
# Total budget for the whole orchestrator->main_agent->subagent(s)->reviewer
# pipeline. Raise this further if you're running slow local/CPU models.
TASK_TIMEOUT_SECONDS=1800

# --- Retention ---
# Task sessions and agent logs are deleted by a MongoDB TTL index this many
# days after they are created. Dashboard metrics only cover this window.
TASK_RETENTION_DAYS=7

# --- LLM HTTP client timeouts (seconds) ---
# Per-call read timeout; local CPU models can take a while to generate.
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_CONNECT_TIMEOUT_SECONDS=10

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# =========================================================================
# Frontend (frontend/.env.local) — reference only
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# SITE_URL=http://localhost:3000   # canonical/sitemap/OG origin, server-only
# =========================================================================
