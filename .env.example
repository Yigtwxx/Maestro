# =========================================================================
# Maestro Platform — Environment Variables (example)
# Copy to `.env` and fill real values. NEVER commit `.env`.
# =========================================================================

# --- Databases ---
POSTGRES_URL=postgresql+asyncpg://maestro:maestro@localhost:5433/maestro
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=maestro

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Security ---
# Generate JWT secret:        openssl rand -hex 32
JWT_SECRET=change-me-please-generate-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# AES-256-GCM master key (32 bytes, base64 or 64-char hex).
# Generate:                   openssl rand -base64 32
API_KEY_MASTER_KEY=change-me-32-byte-base64-master-key

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Free / local model (Ollama, OpenAI-compatible) ---
FREE_MODEL_ENDPOINT=http://localhost:11434/v1
FREE_MODEL_NAME=qwen3
EMBEDDING_MODEL_NAME=nomic-embed-text
# nomic-embed-text embedding dimension
EMBEDDING_DIM=768

# --- Default agent limits ---
MAX_ITERATIONS=10
MAX_REVIEW_ITERATIONS=3
TASK_TIMEOUT_SECONDS=300

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# =========================================================================
# Frontend (frontend/.env.local) — reference only
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# =========================================================================
