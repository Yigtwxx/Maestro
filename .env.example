# =========================================================================
# Maestro Platform — Environment Variables (example)
# Copy to `.env` and fill real values. NEVER commit `.env`.
# =========================================================================

# --- Databases ---
# Both ports are shifted off the default on purpose: a natively-installed
# PostgreSQL or MongoDB already owns 5432/27017 on many dev machines, and a
# native server bound to loopback beats Docker's wildcard bind — so the default
# port would silently reach the wrong server. See docker-compose.yml.
POSTGRES_URL=postgresql+asyncpg://maestro:maestro@localhost:5433/maestro
MONGODB_URL=mongodb://localhost:27018
MONGODB_DB_NAME=maestro

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Rate limiting ---
# Leave REDIS_URL empty to keep buckets in process memory (correct for a single
# dev worker). Set it to share them across workers: `docker compose up -d redis`.
REDIS_URL=
# RATE_LIMIT_ENABLED=false turns throttling off entirely. Never in production.
RATE_LIMIT_ENABLED=true
# Only true behind a reverse proxy that appends X-Forwarded-For. With the
# backend directly exposed, a client could forge the header and dodge its bucket.
TRUST_PROXY_HEADERS=false

# --- Security ---
# Generate JWT secret:        openssl rand -hex 32
JWT_SECRET=change-me-please-generate-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# AES-256-GCM master key (32 bytes, base64 or 64-char hex).
# Generate:                   openssl rand -base64 32
API_KEY_MASTER_KEY=change-me-32-byte-base64-master-key

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Payments ---
# Only "mock" is implemented: it validates Visa/Mastercard numbers (Luhn, BIN)
# and moves no real money. Plugging in a real processor means adding an adapter
# under app/services/payment/, not changing this value's consumers.
# Prices, quotas and the trial length are product constants, not env config.
PAYMENT_PROVIDER=mock

# --- Transactional email ---
# "console" (default) logs emails to the server log — dev/self-host needs no
# sender; the verification link is copied from the log. "resend" sends through
# the Resend HTTP API and requires RESEND_API_KEY.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Maestro <noreply@maestro.example.com>"
# Backend-side base URL for action links inside emails (verification, reset).
# Point it at the public frontend origin. Distinct from the frontend's own
# server-only SITE_URL, which the backend container cannot see.
SITE_URL=http://localhost:3000
# Soft gate: unverified accounts cannot start tasks or add API keys (403).
# Self-hosters may set false; verification emails still go out.
EMAIL_VERIFICATION_REQUIRED=true

# --- Free / local model (Ollama, OpenAI-compatible) ---
FREE_MODEL_ENDPOINT=http://localhost:11434/v1
FREE_MODEL_NAME=qwen3.5:9b
# Drive Ollama's own /api/chat instead of its OpenAI-compatible /v1 shim. The
# shim cannot express think, a JSON-schema format, or num_ctx, and all three
# measurably matter on a local thinking model. Set false to force the shim; the
# adapter also falls back by itself if /api/chat answers 404, so a non-Ollama
# OpenAI-compatible server behind FREE_MODEL_ENDPOINT keeps working.
OLLAMA_NATIVE_API=true
# Thinking is what makes a local member actually use its tools: with it off the
# model must choose between emitting a bare tool directive and writing prose in
# one shot, and it reliably writes prose (measured 0 tool calls over 18 cases).
# The empty-reply risk it used to carry is handled in code — schema-constrained
# calls never think, and an empty free-form reply is retried once without it.
OLLAMA_THINK=true
# Ollama loads a model at 4096 tokens of context unless told otherwise and
# truncates longer prompts from the front — taking the system prompt first.
OLLAMA_NUM_CTX=16384
# RAG and document upload need embeddings whatever chat provider is selected.
# Leave blank to reuse FREE_MODEL_ENDPOINT (the usual local setup). A deployment
# can point this at an embedding-only server without hosting a chat model.
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL_NAME=nomic-embed-text
# nomic-embed-text embedding dimension
EMBEDDING_DIM=768

# --- Gemini (BYOK free tier; key is added per-user via Settings > API Keys) ---
# Model served through Gemini's OpenAI-compatible endpoint. The "-latest"
# alias tracks the newest Flash release and survives model retirements;
# pin a stable id (e.g. gemini-3.5-flash) if deterministic behavior matters.
GEMINI_MODEL_NAME=gemini-flash-latest

# --- Web search (DuckDuckGo via ddgs — free, no API key) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_USES_PER_SUBTASK=2

# --- Data fetch (Scrapling: TLS-fingerprint HTTP + CSS extraction) ---
DATA_FETCH_ENABLED=true
DATA_FETCH_TIMEOUT_SECONDS=15
DATA_FETCH_MAX_USES_PER_SUBTASK=3
# "scrapling" (default) or "httpx". The httpx engine is the pre-Scrapling path:
# no CSS selectors and no anti-bot impersonation, but it does enforce the
# response size cap while streaming. Switch here to roll back without a deploy.
DATA_FETCH_ENGINE=scrapling
# Browser tier for JavaScript-rendered and Cloudflare-walled pages. Self-host
# only: the container image ships no browser binaries, so this needs a
# `scrapling install` (~400MB) inside the image and about 1GB of free RAM per
# concurrent render. The tool works fully without it — leaving this false only
# gives up JS rendering, not the fetch itself.
DATA_FETCH_RENDER_ENABLED=false
DATA_FETCH_RENDER_TIMEOUT_SECONDS=45
DATA_FETCH_RENDER_MAX_CONCURRENCY=1

# --- RAG tools (search the user's OWN uploads + conversation memory) ---
# Keyless and per-user scoped (every query is filtered by user_id), so nothing
# is configured beyond these switches. They degrade to a "no results" note on a
# cold Qdrant, never an error, so they are safe to leave on before any ingest.
DOCUMENT_SEARCH_ENABLED=true
DOCUMENT_SEARCH_MAX_USES_PER_SUBTASK=3
MEMORY_RECALL_ENABLED=true
MEMORY_RECALL_MAX_USES_PER_SUBTASK=3

# --- Main Agent discovery loop (read-only RAG before planning) ---
# When on, the Main Agent may run the RAG tools over the user's own data before
# planning, to ground its plan and delegation. Strictly whitelisted to the RAG
# tools — no external or action tool runs at the main tier.
MAIN_AGENT_DISCOVERY_ENABLED=true
MAIN_AGENT_DISCOVERY_MAX_CALLS=2

# --- Subagent tool escalation (request_tool → Main Agent gatekeeper) ---
# Tools a subagent may be granted mid-run when it needs one it was not assigned.
# Each grant is one extra gatekeeper LLM call, so this bounds escalation cost.
SUBAGENT_MAX_TOOL_GRANTS=2

# --- Connected API tools (BYOK service keys) ---
# These four tools authenticate with a key the *user* stores under
# Settings > API Keys — nothing is configured here. A missing key is never
# fatal: the tool is withheld from the squad and the subagent falls back to
# web_search, reporting the gap in its "Data coverage" section. Set a
# *_ENABLED to false to remove that tool from every squad that declares it —
# the per-tool rollback switch.
#
# repo_intel is the exception worth knowing about: GitHub serves anonymous
# reads at 60 requests/hour, so the opensource squad works with no key at all
# and a stored token only raises the ceiling to 5000.
REPO_INTEL_ENABLED=true
REPO_INTEL_TIMEOUT_SECONDS=15
REPO_INTEL_MAX_RESULTS=30
REPO_INTEL_MAX_USES_PER_SUBTASK=4
# X (Twitter) API v2 recent search. Covers roughly the last 7 days on the
# tiers most BYOK users hold, so a 30d window is requested, not guaranteed.
SOCIAL_SEARCH_ENABLED=true
SOCIAL_SEARCH_TIMEOUT_SECONDS=15
SOCIAL_SEARCH_MAX_RESULTS=25
SOCIAL_SEARCH_MAX_USES_PER_SUBTASK=3
# Discord / Slack / Telegram channel reading. Telegram is weaker by design:
# the Bot API exposes only updates delivered to the bot, not full history.
COMMUNITY_READ_ENABLED=true
COMMUNITY_READ_TIMEOUT_SECONDS=15
COMMUNITY_READ_MAX_RESULTS=50
COMMUNITY_READ_MAX_USES_PER_SUBTASK=3
# Google Places API (New). Review text is a higher-cost SKU, which is why it
# is a separate "reviews" aspect rather than always included.
PLACES_INTEL_ENABLED=true
PLACES_INTEL_TIMEOUT_SECONDS=15
PLACES_INTEL_MAX_RESULTS=20
PLACES_INTEL_MAX_USES_PER_SUBTASK=3

# --- Custom API tools (user-registered HTTP endpoints) ---
# Unlike the four tools above, nothing here is per provider: the endpoint, the
# credential and the parameter schema are all the user's, stored under
# Settings > API Tools. This switch is the whole-feature rollback.
#
# Off by default, like CODE_EXECUTION_ENABLED and for the same kind of reason.
# Every call re-runs the SSRF guard (see LLM_SSRF_GUARD_ENABLED below — the same
# switch covers both), redirects are never followed, and the response is
# size-capped and injection-scanned. But url_guard checks that a hostname
# resolves to a public address without pinning that address to the socket, so
# whoever controls the DNS record can answer the check with a public address and
# the connection with a private one. This is the only tool where the hostname
# comes from a user, which turns that window from theoretical into routine.
#
# Turn it on when the backend runs somewhere an internal address reaches nothing
# worth reaching — a self-hosted instance on a trusted network. Leave it off on a
# shared or cloud deployment until the execution path connects to the address it
# validated.
CUSTOM_API_TOOLS_ENABLED=false
CUSTOM_API_TIMEOUT_SECONDS=15
CUSTOM_API_MAX_USES_PER_SUBTASK=3

# --- Default agent limits ---
MAX_ITERATIONS=10
MAX_REVIEW_ITERATIONS=3
# Total budget for the whole orchestrator->main_agent->subagent(s)->reviewer
# pipeline. Raise this further if you're running slow local/CPU models.
TASK_TIMEOUT_SECONDS=1800

# --- Retention ---
# Task sessions and agent logs are deleted by a MongoDB TTL index this many
# days after they are created. Dashboard metrics only cover this window; keep
# it >= the 14-day trend window or the oldest sparkline days read as zero.
TASK_RETENTION_DAYS=30

# --- LLM HTTP client timeouts (seconds) ---
# Per-call read timeout; local CPU models can take a while to generate.
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_CONNECT_TIMEOUT_SECONDS=10
# Running a local model? A single Ollama instance serialises requests while every
# client's read clock is already ticking, so parallel subagents time out before
# the model reaches them — and a ReadTimeout is never retried. Set
# SUBAGENT_MAX_PARALLEL=1 and raise the two values above (900 / 30 are
# comfortable for a 9B model on consumer hardware), then raise
# TASK_TIMEOUT_SECONDS to match, since serial subagents stretch the wall clock.

# --- Custom LLM endpoint SSRF guard ---
# When true (default), a user's "custom" provider base_url must be http(s),
# credential-free, and resolve only to public addresses. Set false ONLY for a
# fully self-hosted stack where the custom endpoint points at a private host
# (e.g. http://localhost:11434). Never disable on a hosted/multi-tenant deploy.
LLM_SSRF_GUARD_ENABLED=true

# --- App ---
ENVIRONMENT=development
# Uvicorn worker count (Dockerfile passes it to --workers; defaults to 1).
# Values >1 REQUIRE REDIS_URL — enforced at boot, the backend refuses to start
# otherwise (event bus / HITL / cancel coordinate across workers over Redis).
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
# "text" (human-readable) for local dev; "json" for structured logs in prod.
LOG_FORMAT=text

# --- Observability (Sentry error tracking) ---
# Leave SENTRY_DSN empty to disable Sentry entirely (dev/test add no egress).
# Paste the DSN from your Sentry project to enable error tracking.
SENTRY_DSN=
# Tracing/APM sample rate (0.0 = off, protects the free-tier quota).
SENTRY_TRACES_SAMPLE_RATE=0.0
# Overrides the Sentry environment tag; falls back to ENVIRONMENT when empty.
SENTRY_ENVIRONMENT=

# =========================================================================
# Frontend (frontend/.env.local) — reference only
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# SITE_URL=http://localhost:3000   # canonical/sitemap/OG origin, server-only
# SENTRY_DSN=                      # frontend Sentry project DSN, server-read
#                                  # at runtime; empty = tracking disabled
# SENTRY_ENVIRONMENT=              # Sentry env tag; defaults to "production"
# =========================================================================
